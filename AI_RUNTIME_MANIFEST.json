{
  "schema_version": 1,
  "department": "Dr. Victor",
  "auto_bootstrap": true,
  "soul_path": "VICTOR_SOUL.md",
  "governance_paths": [
    "VICTOR_MASTER_RULE_BOOK.md",
    "VICTOR_EXECUTIVE_CHARTER.md"
  ],
  "status_path": "data/ai_runtime_status.json",
  "provider_priority": [
    "anthropic",
    "openai"
  ],
  "providers": {
    "anthropic": {
      "enabled": true,
      "credential_env": "CLAUDE_API_VICTOR",
      "adapter": "providers.anthropic",
      "health_check": "authenticated_models_list",
      "model_candidates": [
        "claude-sonnet-4-20250514",
        "claude-opus-4-1-20250805",
        "claude-3-5-haiku-20241022"
      ],
      "paid_inference_health_test": false
    },
    "openai": {
      "enabled": true,
      "credential_env": "OPENAI_API_KEY",
      "adapter": "providers.openai",
      "health_check": "authenticated_models_list",
      "model_candidates": [
        "gpt-5.6-luna",
        "gpt-5.4-nano"
      ],
      "paid_inference_health_test": false
    }
  },
  "safety": {
    "never_persist_secret_values": true,
    "never_print_secret_values": true,
    "cross_department_secret_copy": false,
    "provider_binding_expands_business_authority": false,
    "paid_inference_requires_separate_authority": true
  },
  "notes": [
    "This manifest implements the Founder-locked SOUL plug-and-play runtime standard for Victor.",
    "Victor uses the dedicated repository-scoped CLAUDE_API_VICTOR credential for Anthropic, with OpenAI retained only as a fallback when separately configured.",
    "Provider health checks authenticate through model-list endpoints and make no paid inference request.",
    "A provider is READY only when authentication succeeds and an accessible model can be deterministically resolved."
  ]
}
