{
  "schema_version": 2,
  "authority": "Founder Vicky",
  "executive": "Dr. Victor",
  "hierarchy": "Founder Vicky -> Dr. Victor -> all department AIs / department heads",
  "heartbeat_minutes": 5,
  "daily_executive_report": {
    "required": true,
    "audience": "Founder Vicky",
    "purpose": "decision-oriented organization-wide business review",
    "sections": [
      "executive_summary",
      "organization_health",
      "department_status",
      "verified_business_and_revenue_progress",
      "material_work_completed",
      "work_in_progress",
      "blockers_and_risks",
      "objective_or_priority_drift",
      "opportunities",
      "founder_actions_required",
      "next_day_priority_stack",
      "evidence_references"
    ]
  },
  "founder_meeting": {
    "required": true,
    "local_time": "22:00",
    "mode": "voice_when_available",
    "report_ready_before_meeting": true
  },
  "department_report_request": {
    "on_stale_state": true,
    "on_conflicting_evidence": true,
    "on_objective_drift": true,
    "on_material_blocker": true,
    "on_founder_request": true
  },
  "truth_model": [
    "OBSERVED",
    "PROCESSED",
    "EXECUTING",
    "API_CONFIRMED",
    "LIVE_VERIFIED",
    "BUSINESS_OUTCOME_VERIFIED"
  ],
  "direct_department_bridge": {
    "rio": {
      "enabled_design": true,
      "transport": "github_workflow_dispatch",
      "victor_workflow": ".github/workflows/victor-rio-direct.yml",
      "victor_client": "scripts/rio_bridge.py",
      "rio_workflow": ".github/workflows/victor-bridge.yml",
      "rio_handler": "scripts/victor_direct_command.py",
      "response_evidence": "rio-affiliate-engine/data/victor_bridge_response.json",
      "credential_secret_name": "VICTOR_RIO_GITHUB_TOKEN",
      "credential_owner": "Victor",
      "credential_scope": "rio-affiliate-engine only; Actions read/write + Contents read",
      "department_secret_sharing": false,
      "victor_is_founder_approval": false,
      "rio_soul_gate_required": true,
      "status": "WAITING_FOR_VICTOR_SCOPED_CREDENTIAL"
    }
  },
  "security": {
    "department_credentials_isolated": true,
    "telegram_is_secret_vault": false,
    "victor_repo_access_does_not_imply_secret_ownership": true,
    "victor_must_not_use_rio_telegram_or_provider_secrets_for_direct_bridge": true
  }
}
