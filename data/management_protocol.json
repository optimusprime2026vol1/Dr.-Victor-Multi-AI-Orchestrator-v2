{
  "schema_version": 7,
  "authority": "Founder Vicky",
  "executive": "Dr. Victor",
  "hierarchy": "Founder Vicky -> Dr. Victor -> all department AIs / department heads",
  "supervision_mode": "OUTCOME_BOUNDARY",
  "architecture_ref": "docs/VICTOR_GOAL_DRIVEN_EXECUTIVE_ARCHITECTURE.md",
  "heartbeat": {
    "default_minutes": 15,
    "minimum_minutes": 2,
    "adaptive_ladder_minutes": [15, 10, 5, 3, 2],
    "event_wake": true,
    "role": "watchdog_and_reconciliation_wake_not_fixed_department_rotation"
  },
  "goal_control_loop": {
    "required": true,
    "goal_registry_ref": "data/goal_registry.json",
    "runtime_state_ref": "data/goal_runtime_state.json",
    "founder_defines_destination": true,
    "victor_owns_route": true,
    "routine_plan_change_requires_founder": false,
    "routine_department_selection_requires_founder": false,
    "repeat_until": ["GOAL_ACHIEVED_VERIFIED", "FOUNDER_HOLD", "FOUNDER_ONLY_BLOCKER", "SAFE_STOP"],
    "no_status_only_success": true,
    "no_unverified_completion": true
  },
  "department_control_loop": {
    "required": true,
    "delegation_style": "OUTCOME_OR_SUBGOAL_CONTRACT",
    "report_fields": ["goal_id", "status", "outcome_progress", "error_or_blocker", "next_action", "evidence"],
    "victor_review_required": "MILESTONE_EXCEPTION_OR_REPLAN_ONLY",
    "routine_step_approval_required": false,
    "next_push_required_if_goal_not_met": true,
    "repeat_until": ["GOAL_ACHIEVED_VERIFIED", "FOUNDER_HOLD", "FOUNDER_ONLY_BLOCKER"],
    "no_status_only_reporting": true,
    "no_unverified_completion": true
  },
  "daily_executive_report": {
    "required": true,
    "audience": "Founder Vicky",
    "purpose": "decision-oriented organization-wide business review",
    "sections": [
      "executive_summary",
      "active_goal_progress",
      "verified_business_and_revenue_progress",
      "material_outcomes_completed",
      "work_in_progress",
      "blockers_and_risks",
      "strategy_or_route_changes",
      "founder_actions_required",
      "next_goal_priority",
      "evidence_references"
    ]
  },
  "founder_meeting": {
    "required": true,
    "local_time": "22:00",
    "mode": "voice_when_available",
    "report_ready_before_meeting": true
  },
  "department_report_request": {
    "on_stale_state": true,
    "on_conflicting_evidence": true,
    "on_objective_drift": true,
    "on_material_blocker": true,
    "on_repeated_error": true,
    "on_missing_outcome_evidence": true,
    "on_founder_request": true
  },
  "victor_enforcement": {
    "push_department_against_own_objective": true,
    "push_department_against_victor_goal_contract": true,
    "challenge_incomplete_answers": true,
    "require_solution_after_error": true,
    "require_evidence_after_execution": true,
    "choose_strategy_autonomously": true,
    "choose_department_route_autonomously": true,
    "change_failed_plan_autonomously": true,
    "stop_low_value_work_for_higher_goal_impact": true,
    "escalate_stagnation_only_when_boundary_level_or_unresolved_after_replan": true
  },
  "truth_model": [
    "PLANNED",
    "DISPATCHED",
    "EXECUTING",
    "API_CONFIRMED",
    "LIVE_VERIFIED",
    "BUSINESS_OUTCOME_VERIFIED",
    "GOAL_ACHIEVED_VERIFIED"
  ],
  "security": {
    "department_credentials_isolated": true,
    "telegram_is_secret_vault": false,
    "victor_repo_access_does_not_imply_secret_ownership": true,
    "credential_vault_owner": "INDIVIDUAL_DEPARTMENT_REPOSITORIES",
    "credential_vault_policy_ref": "data/credential_vault_policy.json",
    "credential_vault_runtime_location": "DEPARTMENT_OWNED_SECRET_STORE",
    "raw_secret_storage_in_repo": false,
    "credential_use_authority": "AUTHORIZED_DEPARTMENT_RUNTIME_UNDER_VICTOR_ORCHESTRATION",
    "credential_use_scope": "Victor may orchestrate governed use of already-provisioned department credentials without receiving or exposing their raw values.",
    "credential_broker_model": "DEPARTMENT_SCOPED_ONLY_NO_SHARED_POOL",
    "raw_secret_disclosure_prohibited": true,
    "department_direct_secret_access_default": true,
    "credential_use_must_be_purpose_scoped": true,
    "credential_use_must_be_auditable": true,
    "credential_use_does_not_expand_credential_or_identity_scope": true,
    "credential_creation_rotation_revocation_or_scope_expansion": "FOUNDER_APPROVAL_REQUIRED",
    "only_credential_administration_requires_founder_approval": true
  }
}
