{
  "schema_version": 2,
  "status": "RETIRED_SUPERSEDED",
  "superseded_by": "DEPARTMENT_SCOPED_REPOSITORY_SECRETS",
  "owner": "Individual department repositories",
  "authority": "Founder Vicky",
  "name": "Department-Scoped Credential Policy",
  "model": "DEPARTMENT_SCOPED_ONLY_NO_SHARED_POOL",
  "location_rule": "Each credential is stored only in the repository or runtime of the department that uses it. Raw secret values must never be stored in tracked repository files.",
  "runtime_secret_store": "DEPARTMENT_OWNED_SECRET_STORE",
  "credential_use_authority": "AUTHORIZED_DEPARTMENT_RUNTIME",
  "department_access_default": "DENY_RAW_SECRET_ACCESS",
  "access_mode": "DIRECT_DEPARTMENT_SCOPED_USE",
  "rules": {
    "victor_may_orchestrate_use_without_receiving_raw_secret": true,
    "use_must_match_founder_approved_objective": true,
    "use_must_match_department_authority": true,
    "raw_secret_return_to_department": false,
    "raw_secret_in_prompt": false,
    "raw_secret_in_logs": false,
    "raw_secret_in_telegram": false,
    "raw_secret_in_repo": false,
    "credential_creation_rotation_revocation_scope_expansion": "FOUNDER_APPROVAL_REQUIRED",
    "shared_master_secret_pool_prohibited": true,
    "audit_required": true
  },
  "operating_flow": [
    "victor_dispatches_objective_aligned_department_task",
    "department_checks_objective_authority_and_automatic_controls",
    "department_runtime_uses_its_own_secret_without_disclosing_value",
    "action_result_and_evidence_return_to_victor",
    "victor_reports_verified_result"
  ]
}
