{
  "schema_version": 2,
  "owner": "Dr. Victor",
  "authority": "Founder Vicky",
  "name": "Victor Credential Vault",
  "model": "CENTRAL_STORAGE_LOGICALLY_SCOPED",
  "location_rule": "The credential vault belongs to Victor runtime. Raw secret values must never be stored in the GitHub repository; the repo contains only policy, identifiers, access mappings and audit metadata.",
  "runtime_secret_store": "VICTOR_MANAGED_SECRET_STORE",
  "credential_use_authority": "DR_VICTOR",
  "department_access_default": "DENY_RAW_SECRET_ACCESS",
  "access_mode": "BROKERED_PURPOSE_SCOPED_USE",
  "runtime_endpoint": "/credential-broker",
  "request_authentication": "DEPARTMENT_SCOPED_HMAC_SHA256",
  "pilot_departments": ["tony_stark", "hulk"],
  "pilot_actions": ["ai.reason", "github.repository.read", "github.workflow_runs.read"],
  "pilot_write_actions": false,
  "audit_mode": "CLOUDFLARE_STRUCTURED_LOG_AND_SIGNED_RECEIPT",
  "rules": {
    "victor_may_use_existing_credentials_without_per_use_founder_approval": true,
    "use_must_match_founder_approved_objective": true,
    "use_must_match_department_authority": true,
    "raw_secret_return_to_department": false,
    "raw_secret_in_prompt": false,
    "raw_secret_in_logs": false,
    "raw_secret_in_telegram": false,
    "raw_secret_in_repo": false,
    "credential_creation_rotation_revocation_scope_expansion": "FOUNDER_APPROVAL_REQUIRED",
    "paid_destructive_production_authority_unchanged": true,
    "audit_required": true
  },
  "operating_flow": [
    "department_or_victor_requests_authorized_action",
    "victor_checks_objective_and_authority",
    "victor_resolves_credential_alias",
    "vault_or_broker_uses_secret_without_disclosing_value",
    "action_result_and_evidence_return_to_victor",
    "victor_reports_verified_result"
  ]
}
